# Environment variables / API keys
.env
.env.*
*.env
secrets.json
credentials.json

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log
logs/

# AWS
.aws/

# Cache
.cache/

# Bot auto-generated outputs - EC2 local only
digests/daily/
data/*
!data/area_aliases.json
# positions.json 은 EC2 배포 입력이라 추적. 저장소가 public 이나 공개돼도 무방하다고 판단함.
!data/positions.json
# position_state.json 은 분기 연속 판정의 유일한 근거다. EC2 로컬에만 두면
# 서버가 죽을 때 몇 달치 누적이 사라지므로 추적한다 (EC2 가 매일 자동 커밋).
!data/position_state.json
# theme_state.json 도 같은 이유. 테마 레이어는 판정을 하지 않으므로
# '같은 흐름 N회 반복' 누적이 유일한 신호 강도이며, 날아가면 복구가 불가능하다.
# ★ 여기 빠뜨리면 git add 가 무시된 파일에서 실패해 position_state 커밋까지 함께 죽는다.
!data/theme_state.json
# events/ 는 종목별 이벤트 히스토리. 포지션 페이지의 원재료이고 재수집이 불가능하다
# (지난 뉴스를 다시 검색해 그날 상태로 복원할 수 없다). 디렉터리를 먼저 되살려야
# 그 안의 파일이 data/* 에 안 걸린다.
!data/events/
scripts/__pycache__/
*.log
digests/sent/
digests/dry-run/

# MkDocs build output (and staging dir created by workflow / local preview)
site/
docs/
.venv-docs/
